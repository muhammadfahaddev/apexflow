// ============================================================
// ApexFlow — Prisma Database Schema
// Fully dynamic, modular schema for PostgreSQL, Supabase, Neon & Local SQLite
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Projects ────────────────────────────────────────────────
model Project {
  id            String   @id @default(uuid())
  name          String
  description   String?
  color         String?
  driveFolderId String?  @map("drive_folder_id")
  status        String   @default("active") // active, paused, completed, archived
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tasks Task[]

  @@map("projects")
}

// ── Tasks ───────────────────────────────────────────────────
model Task {
  id              String    @id @default(uuid())
  title           String
  description     String?
  category        String?
  priority        String    @default("normal") // critical, high, normal, low
  status          String    @default("inbox") // inbox, planned, scheduled, in_progress, waiting, blocked, completed, delayed, skipped, cancelled
  flexibility     String    @default("flexible") // fixed, flexible, semi_flexible
  
  deadline        DateTime?
  preferredTime   DateTime? @map("preferred_time")
  durationMins    Int?      @map("duration_mins")
  
  recurrence      Json?     // { type, interval, daysOfWeek, endsAt }
  dependencies    String[]  @default([])
  reminderConfig  Json?     @default("{\"beforeMins\": [15], \"atStart\": true}") @map("reminder_config")
  
  source          String    @default("manual") // manual, email, calendar, document, agent
  sourceRef       String?   @map("source_ref")
  
  plannedStart    DateTime? @map("planned_start")
  actualStart     DateTime? @map("actual_start")
  plannedEnd      DateTime? @map("planned_end")
  actualEnd       DateTime? @map("actual_end")
  
  rescheduleCount Int       @default(0) @map("reschedule_count")
  reminderCount   Int       @default(0) @map("reminder_count")
  
  projectId       String?   @map("project_id")
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([priority])
  @@index([deadline])
  @@index([projectId])
  @@map("tasks")
}

// ── Activity Log (Append-Only Audit Trail) ───────────────────
model ActivityLog {
  id              String   @id @default(uuid())
  actionType      String   @map("action_type")
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id")
  details         Json?
  initiatedBy     String   @default("agent") @map("initiated_by") // user, agent
  confirmedByUser Boolean? @map("confirmed_by_user")
  reversible      Boolean  @default(true)
  previousState   Json?    @map("previous_state") // For undo
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([actionType])
  @@index([createdAt(sort: Desc)])
  @@map("activity_log")
}

// ── Agent Memory (Long-term Context & Preferences) ──────────
model AgentMemory {
  id         String    @id @default(uuid())
  type       String    // preference, work_pattern, project_context, relationship, operating_rule
  key        String    @unique
  value      String
  confidence Float     @default(1.0)
  lastUsed   DateTime? @map("last_used")
  source     String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("agent_memory")
}

// ── Approvals (Inbox queue for sensitive actions) ───────────
model Approval {
  id          String    @id @default(uuid())
  type        String    // email_send, calendar_event_change, document_edit, drive_delete
  title       String
  description String?
  payload     Json      // Action data to execute upon approval
  preview     Json?     // User-friendly preview data
  status      String    @default("pending") // pending, approved, rejected, expired
  reviewedAt  DateTime? @map("reviewed_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([expiresAt])
  @@map("approvals")
}

// ── User Settings ───────────────────────────────────────────
model UserSettings {
  id                 String   @id @default(uuid())
  aiProvider         String   @default("groq") @map("ai_provider")
  aiModel            String?  @map("ai_model")
  emailAutonomyLevel Int      @default(2) @map("email_autonomy_level") // 0 to 3
  docsMode           String   @default("suggest") @map("docs_mode")
  agentMode          String   @default("normal") @map("agent_mode")
  
  workStartHour      Int      @default(9) @map("work_start_hour")
  workEndHour        Int      @default(18) @map("work_end_hour")
  quietStartHour     Int      @default(23) @map("quiet_start_hour")
  quietEndHour       Int      @default(7) @map("quiet_end_hour")
  
  gmailEnabled       Boolean  @default(false) @map("gmail_enabled")
  calendarEnabled    Boolean  @default(false) @map("calendar_enabled")
  driveEnabled       Boolean  @default(false) @map("drive_enabled")
  docsEnabled        Boolean  @default(false) @map("docs_enabled")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}
